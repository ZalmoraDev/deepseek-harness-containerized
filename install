#!/usr/bin/env bash

# ----- colors -----
ERROR=$'\033[31m'
SUCCESS=$'\033[32m'
INFO=$'\033[34m'
IMPORTANT=$'\033[35m'
PROMPT=$'\033[1;34m'

COMMAND=$'\033[33m'
LOCATION=$'\033[36m'

ENDCOLOR=$'\033[0m'

# Visualize scripts output
dsh_print() {
    local text="$1"
    local color="$2"

    echo "${color}[dsh]${ENDCOLOR} ${text}"
}



# Fail / Interruption handling
set -e
trap 'echo "Interrupted. Exiting safely."; exit 130' INT

dsh_print "Checking if required dependencies are installed" "$INFO"
missing_deps=()

command -v docker >/dev/null 2>&1 || missing_deps+=("docker")
docker compose version >/dev/null 2>&1 || missing_deps+=("docker compose")
command -v git >/dev/null 2>&1 || missing_deps+=("git")

if (( ${#missing_deps[@]} > 0 )); then
    dsh_print "Missing dependencies: ${missing_deps[*]}" "$ERROR"
    dsh_print "EXIT 1" "$ERROR"
    exit 1
fi
# Ask for sudo now if docker isn't started opposed to during the scrip
# Needed to temporarily launch to install plugin(s)
systemctl is-active --quiet docker || { dsh_print "Asking for sudo to start docker.service" "$INFO"; \
sudo systemctl start docker; }



dsh_print "Checking if DeepSeek Harness repo is already present" "$INFO"
if [[ ! -d "./deepseek-harness" ]]; then
  dsh_print "Repo not found, cloning deepseek-harness github project" "$INFO"
  git clone -q --depth 1 https://github.com/deepseek-ai/deepseek-harness.git
  dsh_print "Cloned DeepSeek Harness repo, location:$LOCATION $(pwd)/deepseek-harness/$ENDCOLOR" "$SUCCESS"
fi

dsh_print "Building Docker image (may take a while)" "$INFO"
docker compose build -q 2>/dev/null

dsh_print "Creating Docker container" "$INFO"
docker compose create --quiet-pull 2>/dev/null



DSH_DIR="$(pwd)"
BIN_DIR="$HOME/bin"
WRAPPER="$BIN_DIR/dsh"

dsh_print "Creating wrapper script" "$INFO"
if [ ! -d "$WRAPPER" ]; then
  rm -rf "$WRAPPER"
fi
mkdir -p "$BIN_DIR"

# Wrapper script that will be copied to the users bin dir ($HOME/bin)
cat > "$WRAPPER" << EOF
#!/usr/bin/env bash

DSH_DIR="$DSH_DIR"

case "\$1" in
  start)
    echo "[DHS] Starting..."
    systemctl is-active --quiet docker || sudo systemctl start docker
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" up -d --quiet-pull 2>/dev/null
    echo "[DHS] http://127.0.0.1:3080"
    ;;
  stop)
    echo "[DHS] Stopping..."
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" stop 2>/dev/null
    ;;
  restart)
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" stop 2>/dev/null
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" up -d --quiet-pull 2>/dev/null
    echo "[DHS] http://127.0.0.1:3080"
    ;;

  update)
    cd "\$DSH_DIR" && git pull
    ;;
  uninstall)
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" down -v --rmi local 2>/dev/null
    echo "Removed Docker files"
    rm -rf "\$HOME/bin/dsh"
    echo "Removed dsh home binary"

    read -rp "Remove ~/.dsh? (y/N): " answer
    if [[ "\$answer" =~ ^[Yy]\$ ]]; then
      rm -rf "\$HOME/.dsh"
      echo "Removed ~/.dsh"
    else
      echo "Kept ~/.dsh"
    fi
    ;;

  enter)
    docker exec -it dsh-deepseek-harness sh
    ;;
  volume)
    COMPOSE_FILE="\$DSH_DIR/compose.yml"

    # Locate the SECOND 'volumes:' line (the service-level bind list)
    second_vol_line=\$(awk 'BEGIN{c=0} /^ *volumes:/{c++; if(c==2){print NR; exit}}' "\$COMPOSE_FILE")
    if [ -z "\$second_vol_line" ]; then
      echo "[DHS] No second 'volumes:' section found in \$COMPOSE_FILE"
      exit 1
    fi

    # Raw bind lines (preserve \${HOME}) from the second volumes: to EOF
    mapfile -t raw_binds < <(tail -n +"\$second_vol_line" "\$COMPOSE_FILE" \
      | grep -E '^[[:space:]]*-[[:space:]]' \
      | sed -E 's/^[[:space:]]*-[[:space:]]//; s/[[:space:]]*$//')

    # Resolved absolute host paths + modes (r/w) for matching against current dir
    vol_abs=()
    vol_modes=()
    for bind in "\${raw_binds[@]}"; do
      hp="\${bind%%:*}"
      case "\$hp" in
        */*) ;;
        *) continue ;;
      esac
      hp="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
      vol_abs+=("\$hp")
      case "\$bind" in
        *:ro) vol_modes+=(r) ;;
        *)    vol_modes+=(w) ;;
      esac
    done

    # Detect a parent dir bind in compose.yml that would override any binds made here
    parent_hp=""
    parent_mode=""
    parent_col=""
    cur="\$(pwd)"
    for bind in "\${raw_binds[@]}"; do
      hp="\${bind%%:*}"
      case "\$hp" in
        */*) ;;
        *) continue ;;
      esac
      hp="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
      if [ "\$hp" != "/" ]; then hp="\${hp%/}"; fi
      [ -n "\$hp" ] || continue
      # Keep the deepest (most specific) ancestor of the current directory
      if [[ "\$cur" == "\$hp" || "\$cur" == "\$hp/"* ]] && (( \${#hp} > \${#parent_hp} )); then
        parent_hp="\$hp"
        case "\$bind" in
          *:ro) parent_col="$ERROR"; parent_mode="read-only" ;;
          *)    parent_col="$SUCCESS"; parent_mode="read-write" ;;
        esac
      fi
    done

    # Build checklist from current directory (hidden included, not . or ..)
    items=()
    checked=()
    shopt -s dotglob
    for item in *; do
      [ "\$item" = "." ] && continue
      [ "\$item" = ".." ] && continue
      items+=("\$item")
      full="\$(pwd)/\$item"
      st=""
      for ((vi=0; vi<\${#vol_abs[@]}; vi++)); do
        vp="\${vol_abs[\$vi]}"
        case "\$vp" in
          "\$full"|"\$full/"*) st="\${vol_modes[\$vi]}"; break ;;
        esac
      done
      checked+=("\$st")
    done
    shopt -u dotglob

    # Interactive selection
    sel=0
    while true; do
      clear
      echo "[DHS] Volume checklist for: \$(pwd)"
      echo "  (UP/DOWN move, SPACE/RIGHT cycle ''->r->w, LEFT reverse, a=all w, n=none, ENTER apply, q quit)"
      if [ -n "\$parent_hp" ]; then
        echo "  \${parent_col}docker volume binds don't override parent binds, \$parent_hp is a \$parent_mode mounted parent directory, no child volume binds would work as the parent overrides it$ENDCOLOR"
      fi
      echo ""
      for i in "\${!items[@]}"; do
        st="\${checked[\$i]}"
        if [ "\$st" = "" ]; then mark="[ ]"; else mark="[\$st]"; fi
        case "\$st" in
          r) col="$ERROR"; endc="$ENDCOLOR" ;;
          w) col="$SUCCESS"; endc="$ENDCOLOR" ;;
          *) col=""; endc="" ;;
        esac
        if [ "\$i" = "\$sel" ]; then
          echo "  > \${col}\$mark \${items[\$i]}\${endc}"
        else
          echo "    \${col}\$mark \${items[\$i]}\${endc}"
        fi
      done
      IFS= read -rsn1 key
      case "\$key" in
        \$'\e')
          IFS= read -rsn2 -t 0.1 rest
          key="\$key\$rest"
          case "\$key" in
            \$'\e[A') [ "\$sel" -gt 0 ] && sel=\$((sel-1)) ;;
            \$'\e[B') [ "\$sel" -lt \$((\${#items[@]}-1)) ] && sel=\$((sel+1)) ;;
            \$'\e[C') case "\${checked[\$sel]}" in
                        '') checked[\$sel]="r" ;;
                        r)  checked[\$sel]="w" ;;
                        w)  checked[\$sel]="" ;;
                      esac ;;
            \$'\e[D') case "\${checked[\$sel]}" in
                        '') checked[\$sel]="w" ;;
                        w)  checked[\$sel]="r" ;;
                        r)  checked[\$sel]="" ;;
                      esac ;;
          esac
          ;;
        ' ') case "\${checked[\$sel]}" in
               '') checked[\$sel]="r" ;;
               r)  checked[\$sel]="w" ;;
               w)  checked[\$sel]="" ;;
             esac ;;
        a) for i in "\${!checked[@]}"; do checked[\$i]="w"; done ;;
        n) for i in "\${!checked[@]}"; do checked[\$i]=""; done ;;
        q) echo "Aborted."; exit 0 ;;
        '') break ;;
      esac
    done

    # Apply: rebuild the bind list from selections
    new_binds=()
    # Pass 1: keep, drop, or re-mode existing binds
    for bind in "\${raw_binds[@]}"; do
      hp="\${bind%%:*}"
      # Named volumes (no slash, e.g. dsh_config) are always kept
      case "\$hp" in
        */*) ;;
        *) new_binds+=("\$bind"); continue ;;
      esac
      # Resolve literal \${HOME} / ~ so we compare absolute paths
      hp_abs="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
      hp_n="\${hp_abs%/}"
      own=""
      for i in "\${!items[@]}"; do
        full="\$(pwd)/\${items[\$i]}"
        nf="\${full%/}"
        if [ "\$hp_n" = "\$nf" ]; then
          own="\${items[\$i]}"; st="\${checked[\$i]}"; break
        fi
        # Binds living under an unchecked item are dropped
        if [ "\${checked[\$i]}" = "" ] && [[ "\$hp_n" == "\$nf"/* ]]; then
          own="__remove__"; break
        fi
      done
      if [ "\$own" = "__remove__" ]; then continue; fi
      if [ -z "\$own" ]; then
        # Bind belongs to another directory: keep it verbatim
        new_binds+=("\$bind"); continue
      fi
      case "\$st" in
        "")  continue ;;
        r)   case "\$bind" in
               *:ro) new_binds+=("\$bind") ;;
               *)    new_binds+=("\$bind:ro") ;;
             esac ;;
        w)   case "\$bind" in
               *:ro) new_binds+=("\${bind%:ro}") ;;
               *)    new_binds+=("\$bind") ;;
             esac ;;
      esac
    done
    # Pass 2: add binds for checked items that have none yet
    for i in "\${!items[@]}"; do
      st="\${checked[\$i]}"
      [ "\$st" = "" ] && continue
      item="\${items[\$i]}"
      host="\$(pwd)/\$item"
      present=0
      for b in "\${new_binds[@]}"; do
        bh="\${b%%:*}"
        bh="\$(echo "\$bh" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
        bh="\${bh%/}"; hn="\${host%/}"
        [ "\$bh" = "\$hn" ] && present=1 && break
      done
      [ "\$present" = "1" ] && continue
      if [[ "\$host" == "\$HOME"/* ]]; then
        rel="\${host#\$HOME/}"
        hdisp="\\\${HOME}/\$rel"
        cdisp="/root/\$rel"
      else
        hdisp="\$host"
        cdisp="/root/\${host#/}"
      fi
      if [ -d "\$host" ]; then hdisp="\$hdisp/"; cdisp="\$cdisp/"; fi
      if [ "\$st" = "r" ]; then
        new_binds+=("\$hdisp:\$cdisp:ro")
      else
        new_binds+=("\$hdisp:\$cdisp")
      fi
    done

    # Rewrite the second volumes: section in compose.yml
    mapfile -t clines < "\$COMPOSE_FILE"
    si=\$((second_vol_line - 1))
    ei=\$si
    for ((j=si+1; j<\${#clines[@]}; j++)); do
      if [[ "\${clines[\$j]}" =~ ^[[:space:]] ]]; then
        ei=\$j
      else
        break
      fi
    done
    out=()
    for ((k=0; k<si; k++)); do out+=("\${clines[\$k]}"); done
    out+=("\${clines[\$si]}")
    for b in "\${new_binds[@]}"; do out+=("      - \$b"); done
    for ((k=ei+1; k<\${#clines[@]}; k++)); do out+=("\${clines[\$k]}"); done
    printf '%s\n' "\${out[@]}" > "\$COMPOSE_FILE"
    echo "[DHS] compose.yml volume binds updated."
    ;;
  help)
    echo "Usage: dsh { start | stop | restart | help | update | uninstall | enter | volume }"
    echo "       dsh [pnpm dsh args...] - passthrough to 'pnpm dsh' inside container"
    ;;
  *)
    docker exec -it dsh-deepseek-harness pnpm dsh "\$@"
    ;;
esac
EOF

chmod a+x "$WRAPPER"
dsh_print "Created dsh wrapper binary at:$LOCATION $WRAPPER$ENDCOLOR" "$SUCCESS"



dsh_print "Installing recommended plugin(s)" "$INFO"
dsh start
dsh plugin --profile web add dsh-plugin
dsh plugin --profile web add dsh-cost-meter
dsh stop
dsh_print "Installed: dsh-plugin" "$SUCCESS"


# Create ~/.dsh if not present already
DSH_CONFIG_DIR="$HOME/.dsh"
if [ ! -d "$DSH_CONFIG_DIR" ]; then
  mkdir -p "$DSH_CONFIG_DIR"
elif [ "$(stat -c '%u' "$DSH_CONFIG_DIR")" != "$(id -u)" ]; then
  chown -R "$(id -u):$(id -g)" "$DSH_CONFIG_DIR"
  dsh_print "Changed $LOCATION~/.dsh$ENDCOLOR ownership from root (assigned by DSH build) to your user '$(WHOAMI)'" "$SUCCESS"
fi


dsh_print "" "$SUCCESS"
dsh_print "IMPORTANT: Currently DSH is unable to be hosted on 0.0.0.0, since: 'it would expose remote code execution to the network'." "$IMPORTANT"
dsh_print "This would only be a concern if ran on a local-machine," "$IMPORTANT"
dsh_print "but since this is run in a docker container, which needs port 0.0.0.0 to properly function," "$IMPORTANT"
dsh_print "this script's$LOCATION dsh.dockerfile$ENDCOLOR runs socat to proxy port 3080 on 0.0.0.0 to DSH's internal 127.0.0.1:3079," "$IMPORTANT"
dsh_print "Please visit this link for more information: https://github.com/deepseek-ai/deepseek-harness/discussions/76" "$IMPORTANT"
dsh_print "" "$IMPORTANT"
dsh_print "To avoid sandboxing issues, make sure to always run with 'Full Access'" "$IMPORTANT"
dsh_print "Doing this is NOT a security concern as Docker provides isolation through volume mounting" "$IMPORTANT"
dsh_print "" "$IMPORTANT"



dsh_print "SUCCESSFULLY INSTALLED" "$SUCCESS"
dsh_print "$COMMAND  dsh start$ENDCOLOR" "$INFO"
dsh_print "$COMMAND  dsh stop$ENDCOLOR" "$INFO"
dsh_print "$COMMAND  dsh restart$ENDCOLOR (load new plugins)" "$INFO"
dsh_print "" "$INFO"
dsh_print "$COMMAND  dsh help$ENDCOLOR (print help menu of the local home binary)" "$INFO"
dsh_print "$COMMAND  dsh volume$ENDCOLOR (TUI for adding/removing RW & RO access to files/directories)" "$INFO"
dsh_print "$COMMAND  dsh update$ENDCOLOR (pulls newest github version)" "$INFO"
dsh_print "$COMMAND  dsh uninstall$ENDCOLOR (removes Docker files, asks confirmation for $LOCATION~/.dsh$ENDCOLOR)" "$INFO"
dsh_print "" "$INFO"
dsh_print "Only whilst actively running container:" "$INFO"
dsh_print "$COMMAND  dsh [options] [command] [args...]$ENDCOLOR (access DSH binary with access from host)" "$INFO"
dsh_print "$COMMAND  dsh --help$ENDCOLOR (print help menu of the container DSH binary)" "$INFO"
dsh_print "$COMMAND  dsh enter$ENDCOLOR (docker exec into container as interactive shell)" "$INFO"