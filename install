#!/usr/bin/env bash

# ----- colors -----
RED_BG=$'\033[1;41m'
GREEN_BG=$'\033[1;42m'
BLUE_BG=$'\033[1;44m'
PURPLE_BG=$'\033[1;45m'

YELLOW_FG=$'\033[1;33m'
CYAN_FG=$'\033[1;36m'

ENDCOLOR=$'\033[0m'

# Visualize scripts output
_dsh_msg() {
    local label="$1" color="$2"
    shift 2
    echo "${BLUE_BG} DSH ${ENDCOLOR}${color}${label}${ENDCOLOR} $*"
}

dsh_ok()     { _dsh_msg "  OK  " "$GREEN_BG"  "$@"; }
dsh_info()   { _dsh_msg " INFO " "$BLUE_BG"   "$@"; }
dsh_prompt() { _dsh_msg "PROMPT" "$PURPLE_BG" "$@"; }
dsh_failed() { _dsh_msg "FAILED" "$RED_BG"    "$@" >&2; }

# Print the dsh help menu
print_help() {
    dsh_info "${YELLOW_FG}dsh help$ENDCOLOR - print this home binary's help menu"
    echo
    dsh_info "${YELLOW_FG}dsh start$ENDCOLOR - start dsh container"
    dsh_info "${YELLOW_FG}dsh stop$ENDCOLOR - stop dsh container"
    dsh_info "${YELLOW_FG}dsh restart$ENDCOLOR - load new plugins"
    echo
    dsh_info "${YELLOW_FG}dsh verify$ENDCOLOR - check all volume mounts exist, remove missing entries"
    dsh_info "${YELLOW_FG}dsh volume$ENDCOLOR - TUI for white- & blacklisting files/directories"
    dsh_info "${YELLOW_FG}dsh update$ENDCOLOR - pulls newest github version"
    dsh_info "${YELLOW_FG}dsh reinstall$ENDCOLOR - reruns install script"
    dsh_info "${YELLOW_FG}dsh uninstall$ENDCOLOR - removes Docker files, asks confirmation for $CYAN_FG./config/dsh/*$ENDCOLOR"
    echo
    dsh_info "Only whilst actively running container:"
    dsh_info "${YELLOW_FG}dsh [args...]$ENDCOLOR - passthrough to 'pnpm dsh' inside container"
    dsh_info "${YELLOW_FG}dsh --help$ENDCOLOR - print help menu of the container DSH binary"
    dsh_info "${YELLOW_FG}dsh enter$ENDCOLOR - docker exec into container as interactive shell"
}



# Fail / Interruption handling
set -e

dsh_info "Checking if required dependencies are installed"
missing_deps=()

command -v docker >/dev/null 2>&1 || missing_deps+=("docker")
docker compose version >/dev/null 2>&1 || missing_deps+=("docker compose")
command -v git >/dev/null 2>&1 || missing_deps+=("git")
command -v openssl >/dev/null 2>&1 || missing_deps+=("openSSL")

if (( ${#missing_deps[@]} > 0 )); then
    dsh_failed "Missing dependencies: ${missing_deps[*]}"
    dsh_failed "EXIT 1"
    exit 1
fi
# Ask for sudo now if docker isn't started opposed to during the script
# Needed to temporarily launch to install plugin(s)
systemctl is-active --quiet docker || { dsh_info "Asking for sudo to start docker.service"; \
sudo systemctl start docker; }


dsh_info "Checking if DeepSeek Harness repo is already present"
if [[ ! -d "./workspaces/deepseek-harness" ]]; then
  dsh_info "Repo not found, cloning LATEST deepseek-harness from GitHub"
  mkdir -p workspaces
  cd workspaces
  git clone -q --depth 1 https://github.com/deepseek-ai/deepseek-harness.git >/dev/null 2>&1
  dsh_ok "Cloned DeepSeek Harness repo, location:$CYAN_FG $(pwd)/deepseek-harness/$ENDCOLOR"
  cd ../
fi


dsh_info "Creating compose.yml from$CYAN_FG ./templates/compose.yml$ENDCOLOR"
cp -rn ./templates/compose.yml ./

dsh_info "Building Docker image (may take a while)"
docker compose build -q >/dev/null 2>&1

dsh_info "Creating Docker container"
docker compose create --quiet-pull 2>/dev/null
echo

mkdir -p ./config/

dsh_info "Configuring DeepSeek Harness"
cp -rn ./templates/dsh/ ./config/
dsh_ok "Generated modified$CYAN_FG ./config/dsh/home/node/.dsh/profiles/web/cordis.patch.yml$ENDCOLOR"

dsh_info "Configuring SearXNG"
cp -rn ./templates/searxng/ ./config/
SEARXNG_SERVER_SECRET=$(openssl rand -hex 32)
# Overwrite searxng config opposed to template due to templates not being .gitignored
sed "s/__SECRET_KEY__/$SEARXNG_SERVER_SECRET/" ./templates/searxng/etc/searxng/settings.yml > ./config/searxng/etc/searxng/settings.yml
dsh_ok "Generated modified$CYAN_FG ./config/searxng/etc/searxng/settings.yml$ENDCOLOR"


DSH_DIR="$(pwd)"
BIN_DIR="$HOME/bin"
WRAPPER="$BIN_DIR/dsh"

dsh_info "Creating wrapper script"
if [ ! -d "$WRAPPER" ]; then
  rm -rf "$WRAPPER"
fi
mkdir -p "$BIN_DIR"


# Wrapper script that will be copied to the users bin dir ($HOME/bin)
cat ./scripts/dsh-wrapper > "$WRAPPER"
# Replace the checkout placeholder with the directory install ran from
sed -i "s|__DSH_DIR__|${DSH_DIR//&/\\&}|" "$WRAPPER"

chmod a+x "$WRAPPER"
dsh_ok "Created dsh wrapper binary at:$CYAN_FG $WRAPPER$ENDCOLOR"
echo

dsh start >/dev/null 2>&1
dsh_info "Installing & Updating recommended plugins (may take a while)"
dsh plugin --profile web add dshmarket
dsh plugin --profile web add dsh-context
dsh plugin --profile web add @linxin666/dsh-client-ui-skill-explorer@latest
dsh plugin --profile web allow-version @michengai/dsh-archive-manager@1.1.8 --dsh-version 0.2.1-rc.3 --accept-risk
dsh stop >/dev/null 2>&1
dsh_ok "Installed dsh plugins"


# Create ~/.dsh if not present already
DSH_CONFIG_DIR="$HOME/.dsh"
if [ ! -d "$DSH_CONFIG_DIR" ]; then
  mkdir -p "$DSH_CONFIG_DIR"
elif [ "$(stat -c '%u' "$DSH_CONFIG_DIR")" != "$(id -u)" ]; then
  chown -R "$(id -u):$(id -g)" "$DSH_CONFIG_DIR"
  dsh_ok "Changed $CYAN_FG~/.dsh$ENDCOLOR ownership from root (assigned by DSH build) to your user '$(WHOAMI)'"
fi

echo
echo "-----------------------------------------------------------------------------------------------"
echo
dsh_ok "SUCCESSFULLY INSTALLED"
echo

print_help
