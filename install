#!/usr/bin/env bash

# ----- colors -----
ERROR=$'\033[31m'
SUCCESS=$'\033[32m'
INFO=$'\033[34m'
IMPORTANT=$'\033[35m'
PROMPT=$'\033[1;34m'

COMMAND=$'\033[33m'
LOCATION=$'\033[36m'

ENDCOLOR=$'\033[0m'

# Visualize scripts output
dsh_print() {
    local text="$1"
    local color="$2"

    echo "${color}[dsh]${ENDCOLOR} ${text}"
}

# Print the dsh help menu
print_help() {
    echo "${COMMAND}dsh help$ENDCOLOR - print this home binary's help menu" "$INFO"
    echo
    echo "${COMMAND}dsh start$ENDCOLOR - start dsh container" "$INFO"
    echo "${COMMAND}dsh stop$ENDCOLOR - stop dsh container" "$INFO"
    echo "${COMMAND}dsh restart$ENDCOLOR - load new plugins" "$INFO"
    echo
    echo "${COMMAND}dsh verify$ENDCOLOR - check all volume mounts exist, remove missing entries" "$INFO"
    echo "${COMMAND}dsh volume$ENDCOLOR - TUI for mounting a parent directory and blacklisting (shadowing) files/directories" "$INFO"
    echo "${COMMAND}dsh update$ENDCOLOR - pulls newest github version" "$INFO"
    echo "${COMMAND}dsh reinstall$ENDCOLOR - reruns install script" "$INFO"
    echo "${COMMAND}dsh uninstall$ENDCOLOR - removes Docker files, asks confirmation for $LOCATION./config/dsh/*$ENDCOLOR" "$INFO"
    echo
    echo "Only whilst actively running container:" "$INFO"
    echo "${COMMAND}dsh [args...]$ENDCOLOR - passthrough to 'pnpm dsh' inside container" "$INFO"
    echo "${COMMAND}dsh --help$ENDCOLOR - print help menu of the container DSH binary" "$INFO"
    echo "${COMMAND}dsh enter$ENDCOLOR - docker exec into container as interactive shell" "$INFO"
}



# Fail / Interruption handling
set -e
trap 'echo "Interrupted. Exiting safely."; exit 130' INT

dsh_print "Checking if required dependencies are installed" "$INFO"
missing_deps=()

command -v docker >/dev/null 2>&1 || missing_deps+=("docker")
docker compose version >/dev/null 2>&1 || missing_deps+=("docker compose")
command -v git >/dev/null 2>&1 || missing_deps+=("git")
command -v openssl >/dev/null 2>&1 || missing_deps+=("openSSL")

if (( ${#missing_deps[@]} > 0 )); then
    dsh_print "Missing dependencies: ${missing_deps[*]}" "$ERROR"
    dsh_print "EXIT 1" "$ERROR"
    exit 1
fi
# Ask for sudo now if docker isn't started opposed to during the scrip
# Needed to temporarily launch to install plugin(s)
systemctl is-active --quiet docker || { dsh_print "Asking for sudo to start docker.service" "$INFO"; \
sudo systemctl start docker; }



dsh_print "Checking if DeepSeek Harness repo is already present" "$INFO"
if [[ ! -d "./deepseek-harness" ]]; then
  dsh_print "Repo not found, cloning deepseek-harness github project" "$INFO"
  git clone -q --depth 1 https://github.com/deepseek-ai/deepseek-harness.git
  dsh_print "Cloned DeepSeek Harness repo, location:$LOCATION $(pwd)/deepseek-harness/$ENDCOLOR" "$SUCCESS"
fi

dsh_print "Building Docker image (may take a while)" "$INFO"
docker compose build -q 2>/dev/null

dsh_print "Creating Docker container" "$INFO"
docker compose create --quiet-pull 2>/dev/null
echo

dsh_print "Configuring DeepSeek Harness" "$INFO"
mkdir -p ./config/dsh/profiles/web/
cat ./templates/dsh/profiles/web/cordis.patch.yml > ./config/dsh/profiles/web/cordis.patch.yml
dsh_print "Generated modified$LOCATION config/dsh/profiles/web/cordis.patch.yml$ENDCOLOR" "$SUCCESS"


dsh_print "Configuring SearXNG" "$INFO"
mkdir -p ./config/searxng
SEARXNG_SERVER_SECRET=$(openssl rand -hex 32)
# Substitute __SECRET_KEY__ with generated, overwrite searxng with this edited version
sed "s/__SECRET_KEY__/$SEARXNG_SERVER_SECRET/" ./templates/searxng/settings.yml > ./config/searxng/settings.yml
dsh_print "Generated modified$LOCATION config/searxng/settings.yml$ENDCOLOR" "$SUCCESS"



DSH_DIR="$(pwd)"
BIN_DIR="$HOME/bin"
WRAPPER="$BIN_DIR/dsh"

dsh_print "Creating wrapper script" "$INFO"
if [ ! -d "$WRAPPER" ]; then
  rm -rf "$WRAPPER"
fi
mkdir -p "$BIN_DIR"


# Wrapper script that will be copied to the users bin dir ($HOME/bin)
cat > "$WRAPPER" << EOF
#!/usr/bin/env bash

DSH_DIR="$DSH_DIR"

ERROR=$'\033[31m'
SUCCESS=$'\033[32m'
INFO=$'\033[34m'
IMPORTANT=$'\033[35m'
PROMPT=$'\033[1;34m'
COMMAND=$'\033[33m'
LOCATION=$'\033[36m'
ENDCOLOR=$'\033[0m'

dsh_print() {
    local text="\$1"
    local color="\$2"
    echo "\${color}[dsh]\${ENDCOLOR} \${text}"
}

print_help() {
    echo "${COMMAND}dsh help$ENDCOLOR - print this home binary's help menu" "$INFO"
    echo
    echo "${COMMAND}dsh start$ENDCOLOR - start dsh container" "$INFO"
    echo "${COMMAND}dsh stop$ENDCOLOR - stop dsh container" "$INFO"
    echo "${COMMAND}dsh restart$ENDCOLOR - load new plugins" "$INFO"
    echo
    echo "${COMMAND}dsh verify$ENDCOLOR - check all volume mounts exist, remove missing entries" "$INFO"
    echo "${COMMAND}dsh volume$ENDCOLOR - TUI for mounting a parent directory and blacklisting (shadowing) files/directories" "$INFO"
    echo "${COMMAND}dsh update$ENDCOLOR - pulls newest github version" "$INFO"
    echo "${COMMAND}dsh reinstall$ENDCOLOR - reruns install script to reconfigure dsh" "$INFO"
    echo "${COMMAND}dsh uninstall$ENDCOLOR - removes Docker files, asks confirmation for $LOCATION~/.dsh$ENDCOLOR" "$INFO"
    echo
    echo "Only whilst actively running container:" "$INFO"
    echo "${COMMAND}dsh [args...]$ENDCOLOR - passthrough to 'pnpm dsh' inside container" "$INFO"
    echo "${COMMAND}dsh --help$ENDCOLOR - print help menu of the container DSH binary" "$INFO"
    echo "${COMMAND}dsh enter$ENDCOLOR - docker exec into container as interactive shell" "$INFO"
}

case "\$1" in
  help)
    print_help
    ;;

  start)
    dsh_print "Starting..." "\$INFO"
    "\$HOME/bin/dsh" verify
    systemctl is-active --quiet docker || sudo systemctl start docker
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" up -d --quiet-pull 2>/dev/null
    echo
    dsh_print "DeepSeek Harness: http://127.0.0.1:3080" "\$SUCCESS"
    dsh_print "SearXNG:          http://127.0.0.1:3081" "\$SUCCESS"
    ;;
  stop)
    dsh_print "Stopping..." "\$INFO"
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" stop 2>/dev/null
    ;;
  restart)
    dsh_print "Restarting..." "\$INFO"
    "\$HOME/bin/dsh" verify
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" stop 2>/dev/null
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" up -d --quiet-pull 2>/dev/null
    echo
    dsh_print "DeepSeek Harness: http://127.0.0.1:3080" "\$SUCCESS"
    dsh_print "SearXNG:          http://127.0.0.1:3081" "\$SUCCESS"
    ;;

  update)
    cd "\$DSH_DIR" && git pull
    ;;
  reinstall)
    dsh_print "Reinstalling..." "\$INFO"
    "\$DSH_DIR/install"
    ;;
  uninstall)
    docker compose -p dsh -f "\$DSH_DIR/compose.yml" down -v --rmi local 2>/dev/null
    dsh_print "Removed Docker files" "\$SUCCESS"
    rm -rf "\$HOME/bin/dsh"
    dsh_print "Removed dsh home binary" "\$SUCCESS"

    read -rp "Remove ~/.dsh? (y/N): " answer
    if [[ "\$answer" =~ ^[Yy]\$ ]]; then
      rm -rf "\$HOME/.dsh"
      dsh_print "Removed ~/.dsh" "\$SUCCESS"
    else
      dsh_print "Kept ~/.dsh" "\$INFO"
    fi
    ;;

  enter)
    docker exec -it -u node -w /home/node/app dsh-deepseek-harness sh
    ;;
  volume)
    COMPOSE_FILE="\$DSH_DIR/compose.yml"

    second_vol_line=\$(awk '/^ *volumes:.*KEEP THE FIRST LINE/{print NR; exit}' "\$COMPOSE_FILE")
    if [ -z "\$second_vol_line" ]; then
      second_vol_line=\$(awk 'BEGIN{c=0} /^ *volumes:/{c++; if(c==2){print NR; exit}}' "\$COMPOSE_FILE")
    fi
    if [ -z "\$second_vol_line" ]; then
      dsh_print "Could not locate the deepseek-harness 'volumes:' section in \$COMPOSE_FILE" "\$ERROR"
      exit 1
    fi

    # Raw volume lines (preserve \${HOME}) from the second volumes: to EOF
    mapfile -t raw_binds < <(tail -n +"\$second_vol_line" "\$COMPOSE_FILE" \
      | grep -E '^[[:space:]]*-[[:space:]]' \
      | sed -E 's/^[[:space:]]*-[[:space:]]//; s/[[:space:]]*$//')

    # Classify every line (blacklist logic):
    #   named  -> named volume, kept verbatim
    #   host   -> host bind, b_mode r (ro) / w (rw)
    #   shadow -> blacklisting bind, b_mode x:
    #             files   -> /dev/null bound over the item's container path
    #             dirs    -> bare anonymous volume at the container path
    # \${HOME} cannot be part of a shadow: compose expands it on the host, so
    # the line would bind/mount at a path that does not exist in the
    # container. Legacy bare \${HOME}/... shadow lines are recognized when
    # reading and normalized on apply.
    b_kind=(); b_host=(); b_cont=(); b_mode=()
    for bind in "\${raw_binds[@]}"; do
      case "\$bind" in
        *:*)
          hp="\${bind%%:*}"
          case "\$hp" in
            */*) ;;
            *) b_kind+=("named"); b_host+=(""); b_cont+=(""); b_mode+=(""); continue ;;
          esac
          cp="\${bind#*:}"
          mode="w"
          case "\$cp" in
            *:ro) cp="\${cp%:ro}"; mode="r" ;;
          esac
          if [ "\$cp" != "/" ]; then cp="\${cp%/}"; fi
          if [ "\$hp" = "/dev/null" ]; then
            # blacklisted file: the host null device bound over the item
            b_kind+=("shadow"); b_host+=(""); b_cont+=("\$cp"); b_mode+=("x")
            continue
          fi
          hp="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
          if [ "\$hp" != "/" ]; then hp="\${hp%/}"; fi
          b_kind+=("host"); b_host+=("\$hp"); b_cont+=("\$cp"); b_mode+=("\$mode")
          ;;
        /*|'\${HOME}'*|\\~*)
          sp="\$(echo "\$bind" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
          if [ "\$sp" != "/" ]; then sp="\${sp%/}"; fi
          b_kind+=("shadow"); b_host+=(""); b_cont+=("\$sp"); b_mode+=("x")
          ;;
        *) b_kind+=("named"); b_host+=(""); b_cont+=(""); b_mode+=("") ;;
      esac
    done

    # Map a shadow (anonymous volume) path back to its host path:
    # 1. through the deepest host bind whose container path contains it,
    # 2. through the default \${HOME} <-> /home/node mapping,
    # 3. else treat the line as a \${HOME}-prefixed host path (legacy form).
    resolve_shadow() {
      local sp="\$1" j hp cp best="" best_len=-1
      for j in "\${!b_kind[@]}"; do
        [ "\${b_kind[\$j]}" = "host" ] || continue
        hp="\${b_host[\$j]}"; cp="\${b_cont[\$j]}"
        if [ "\$sp" = "\$cp" ] || [[ "\$sp" == "\$cp/"* ]]; then
          if (( \${#cp} > best_len )); then best="\$hp\${sp#\$cp}"; best_len=\${#cp}; fi
        fi
      done
      if [ -n "\$best" ]; then echo "\$best"; return; fi
      if [ "\$sp" = "/home/node" ]; then echo "\$HOME"; return; fi
      case "\$sp" in
        /home/node/*) echo "\$HOME/\${sp#/home/node/}" ;;
        *)            echo "\$sp" ;;
      esac
    }

    # Detect the deepest mounted parent directory of the current directory.
    # Its state decides what children inherit: r/w through its bind, or
    # nothing when the parent itself is blacklisted with a shadow bind (x).
    parent_hp=""
    parent_cp=""
    parent_mode=""
    cur="\$(pwd)"
    for i in "\${!b_kind[@]}"; do
      [ "\${b_kind[\$i]}" = "named" ] && continue
      hp="\${b_host[\$i]}"
      if [ "\${b_kind[\$i]}" = "shadow" ]; then hp="\$(resolve_shadow "\${b_cont[\$i]}")"; fi
      [ -n "\$hp" ] || continue
      # Keep the deepest (most specific) ancestor of the current directory
      if [[ "\$cur" == "\$hp" || "\$cur" == "\$hp/"* ]] && (( \${#hp} > \${#parent_hp} )); then
        parent_hp="\$hp"; parent_cp="\${b_cont[\$i]}"; parent_mode="\${b_mode[\$i]}"
      fi
    done

    # Build checklist from current directory (hidden included, not . or ..)
    # States: '' no explicit bind (inherits the mounted parent), r ro bind,
    #         w rw bind, x blacklisted via an anonymous shadow bind
    items=()
    checked=()
    shopt -s dotglob
    for item in *; do
      [ "\$item" = "." ] && continue
      [ "\$item" = ".." ] && continue
      items+=("\$item")
      full="\$(pwd)/\$item"
      st=""
      for i in "\${!b_kind[@]}"; do
        [ "\${b_kind[\$i]}" = "shadow" ] || continue
        if [ "\$(resolve_shadow "\${b_cont[\$i]}")" = "\$full" ]; then st="x"; break; fi
      done
      if [ -z "\$st" ]; then
        for i in "\${!b_kind[@]}"; do
          [ "\${b_kind[\$i]}" = "host" ] || continue
          if [ "\${b_host[\$i]}" = "\$full" ]; then st="\${b_mode[\$i]}"; break; fi
        done
      fi
      checked+=("\$st")
    done
    shopt -u dotglob

    # Interactive selection
    sel=0
    while true; do
      clear
      dsh_print "Volume checklist for: \$(pwd)" "\$INFO"
      echo "  (UP/DOWN move, SPACE/RIGHT cycle ''->r->w->x, LEFT reverse, a=all w, n=none, ENTER apply, q quit)"
      if [ -n "\$parent_hp" ]; then
        case "\$parent_mode" in
          w) echo "  ${SUCCESS}\$parent_hp is a read-write mounted parent directory, everything below it is already accessible in the container, mark items [x] to blacklist (shadow) them$ENDCOLOR" ;;
          r) echo "  ${INFO}\$parent_hp is a read-only mounted parent directory, everything below it is already readable in the container, [w] grants an item its own read-write bind, [x] blacklists (shadows) it$ENDCOLOR" ;;
          x) echo "  ${ERROR}\$parent_hp is a blacklisted [x] parent, an anonymous volume shadows it so nothing below it is accessible in the container$ENDCOLOR" ;;
        esac
      else
        echo "  ${INFO}no mounted parent directory found, items only reach the container through their own [r]/[w] bind$ENDCOLOR"
      fi
      echo ""
      for i in "\${!items[@]}"; do
        st="\${checked[\$i]}"
        if [ "\$st" = "" ]; then mark="[ ]"; else mark="[\$st]"; fi
        case "\$st" in
          r) col="$INFO"; endc="$ENDCOLOR" ;;
          w) col="$SUCCESS"; endc="$ENDCOLOR" ;;
          x) col="$ERROR"; endc="$ENDCOLOR" ;;
          *) col=""; endc="" ;;
        esac
        if [ "\$i" = "\$sel" ]; then
          echo "  > \${col}\$mark \${items[\$i]}\${endc}"
        else
          echo "    \${col}\$mark \${items[\$i]}\${endc}"
        fi
      done
      IFS= read -rsn1 key
      case "\$key" in
        \$'\e')
          IFS= read -rsn2 -t 0.1 rest
          key="\$key\$rest"
          case "\$key" in
            \$'\e[A') [ "\$sel" -gt 0 ] && sel=\$((sel-1)) ;;
            \$'\e[B') [ "\$sel" -lt \$((\${#items[@]}-1)) ] && sel=\$((sel+1)) ;;
            \$'\e[C') case "\${checked[\$sel]}" in
                        '') checked[\$sel]="r" ;;
                        r)  checked[\$sel]="w" ;;
                        w)  checked[\$sel]="x" ;;
                        x)  checked[\$sel]="" ;;
                      esac ;;
            \$'\e[D') case "\${checked[\$sel]}" in
                        '') checked[\$sel]="x" ;;
                        x)  checked[\$sel]="w" ;;
                        w)  checked[\$sel]="r" ;;
                        r)  checked[\$sel]="" ;;
                      esac ;;
          esac
          ;;
        ' ') case "\${checked[\$sel]}" in
               '') checked[\$sel]="r" ;;
               r)  checked[\$sel]="w" ;;
               w)  checked[\$sel]="x" ;;
               x)  checked[\$sel]="" ;;
             esac ;;
        a) for i in "\${!checked[@]}"; do checked[\$i]="w"; done ;;
        n) for i in "\${!checked[@]}"; do checked[\$i]=""; done ;;
        q) echo "Aborted."; exit 0 ;;
        '') break ;;
      esac
    done

    # Apply: rebuild the bind list from selections (blacklist/shadow logic)
    new_binds=()

    # host -> container targets of existing host binds, so re-marked items
    # keep their original mount point inside the container
    map_host=(); map_cont=()
    for i in "\${!b_kind[@]}"; do
      [ "\${b_kind[\$i]}" = "host" ] || continue
      h="\${b_host[\$i]}"; c="\${b_cont[\$i]}"
      dup=0
      for j in "\${!map_host[@]}"; do [ "\${map_host[\$j]}" = "\$h" ] && dup=1 && break; done
      [ "\$dup" = "1" ] || { map_host+=("\$h"); map_cont+=("\$c"); }
    done

    # Container path for a host path: known target of an existing bind,
    # else through the deepest mounted parent, else the default
    # \${HOME} <-> /home/node convention
    cont_for() {
      local full="\${1%/}" j bh="" bc="" hp2 best=-1 sfx
      for j in "\${!map_host[@]}"; do
        if [ "\${map_host[\$j]}" = "\$full" ]; then echo "\${map_cont[\$j]}"; return; fi
      done
      for j in "\${!b_kind[@]}"; do
        # only real host binds provide container mount targets
        [ "\${b_kind[\$j]}" = "host" ] || continue
        hp2="\${b_host[\$j]}"
        if [[ "\$full" == "\$hp2" || "\$full" == "\$hp2/"* ]] && (( \${#hp2} > best )); then
          best=\${#hp2}; bh="\$hp2"; bc="\${b_cont[\$j]}"
        fi
      done
      if [ -n "\$bh" ]; then
        sfx="\$full"
        sfx="\${sfx#\$bh}"
        if [ "\$bh" = "/" ]; then sfx="/\$sfx"; fi
        echo "\$bc\$sfx"
        return
      fi
      if [[ "\$full" == "\$HOME" ]]; then echo "/home/node"; return; fi
      if [[ "\$full" == "\$HOME/"* ]]; then echo "/home/node/\${full#"\$HOME/"}"; return; fi
      echo "/home/node\${full}"
    }

    # Pass 1: drop every line owned by a listed item of this directory, except
    # host binds whose state is still r/w (kept in place, :ro adjusted).
    # Their state alone decides what gets re-emitted in pass 2.
    for i in "\${!b_kind[@]}"; do
      kind="\${b_kind[\$i]}"
      if [ "\$kind" = "named" ]; then new_binds+=("\${raw_binds[\$i]}"); continue; fi
      hp="\${b_host[\$i]}"
      if [ "\$kind" = "shadow" ]; then hp="\$(resolve_shadow "\${b_cont[\$i]}")"; fi
      own=""; st=""
      for j in "\${!items[@]}"; do
        full="\$(pwd)/\${items[\$j]}"
        if [ "\$hp" = "\$full" ]; then own="1"; st="\${checked[\$j]}"; break; fi
      done
      if [ -z "\$own" ]; then
        # Line belongs to another directory or is a named volume: keep verbatim
        new_binds+=("\${raw_binds[\$i]}"); continue
      fi
      if [ "\$kind" = "host" ]; then
        case "\$st" in
          r) case "\${raw_binds[\$i]}" in
               *:ro) new_binds+=("\${raw_binds[\$i]}") ;;
               *)    new_binds+=("\${raw_binds[\$i]}:ro") ;;
             esac ;;
          w) case "\${raw_binds[\$i]}" in
               *:ro) new_binds+=("\${raw_binds[\$i]%:ro}") ;;
               *)    new_binds+=("\${raw_binds[\$i]}") ;;
             esac ;;
        esac
      fi
    done

    # Pass 2: emit one canonical line per selected item that has none yet.
    # A shadow (x) is written against the CONTAINER path (/home/node/...) —
    # where the parent bind exposes the item — so the mount actually covers
    # it: files get the host's /dev/null bound over them, directories get a
    # bare anonymous volume (a file cannot be mounted over a directory).
    # \${HOME} cannot be used in a shadow: compose expands it on the host,
    # hiding nothing. The host side of r/w binds keeps the literal
    # \${HOME} prefix.
    for j in "\${!items[@]}"; do
      st="\${checked[\$j]}"
      [ -n "\$st" ] || continue
      item="\${items[\$j]}"
      host="\$(pwd)/\$item"
      present=0
      for b in "\${new_binds[@]}"; do
        case "\$b" in
          *:*) bh="\${b%%:*}" ;;
          *)   bh="" ;;
        esac
        case "\$bh" in
          */*) ;;
          *) bh="" ;;
        esac
        [ -n "\$bh" ] || continue
        bh="\$(echo "\$bh" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
        bh="\${bh%/}"
        [ "\$bh" = "\$host" ] && present=1 && break
      done
      [ "\$present" = "1" ] && continue
      ct="\$(cont_for "\$host")"
      if [[ "\$host" == "\$HOME/"* ]]; then
        rel="\${host#"\$HOME/"}"
        hdisp="\\\${HOME}/\$rel"
      else
        hdisp="\$host"
      fi
      case "\$st" in
        x) if [ -d "\$host" ]; then
             new_binds+=("\$ct")
           else
             new_binds+=("/dev/null:\$ct")
           fi ;;
        r) new_binds+=("\$hdisp:\$ct:ro") ;;
        w) new_binds+=("\$hdisp:\$ct") ;;
      esac
    done

    # Rewrite the second volumes: section in compose.yml
    mapfile -t clines < "\$COMPOSE_FILE"
    si=\$((second_vol_line - 1))
    ei=\$si
    for ((j=si+1; j<\${#clines[@]}; j++)); do
      if [[ "\${clines[\$j]}" =~ ^[[:space:]] ]]; then
        ei=\$j
      else
        break
      fi
    done
    out=()
    for ((k=0; k<si; k++)); do out+=("\${clines[\$k]}"); done
    out+=("\${clines[\$si]}")
    for b in "\${new_binds[@]}"; do out+=("      - \$b"); done
    for ((k=ei+1; k<\${#clines[@]}; k++)); do out+=("\${clines[\$k]}"); done
    printf '%s\n' "\${out[@]}" > "\$COMPOSE_FILE"
    dsh_print "compose.yml volume binds updated." "\$SUCCESS"
    ;;

  verify)
    COMPOSE_FILE="\$DSH_DIR/compose.yml"

    if [ ! -f "\$COMPOSE_FILE" ]; then
      dsh_print "Error: compose.yml not found at \$COMPOSE_FILE" "\$ERROR"
      exit 1
    fi

    echo
    dsh_print "Verifying volume mounts in $LOCATION\$COMPOSE_FILE$ENDCOLOR" "\$INFO"

    # Collect volume bind lines from the deepseek-harness service
    # Find the line number of the second 'volumes:' block
    vol_line=\$(awk 'BEGIN{c=0} /^ *volumes:/{c++; if(c==2){print NR; exit}}' "\$COMPOSE_FILE")
    if [ -z "\$vol_line" ]; then
      dsh_print "Could not locate the deepseek-harness 'volumes:' section" "\$ERROR"
      exit 1
    fi

    # Extract bind entries: from the second volumes: line until the next top-level key
    # Use sed to grab the block, grep for "- path:" lines, strip the leading "- "
    raw_binds_text=\$(sed -n "\${vol_line},\$ { /^[^ ]/{q}; p }" "\$COMPOSE_FILE" \
      | grep -E '^\s*-\s+\S.*:' \
      | sed -E 's/^\s*-\s+//; s/\s*$//')

    mapfile -t raw_binds <<< "\$raw_binds_text"
    # Remove empty element if mapfile produced one from trailing newline
    if [ \${#raw_binds[@]} -gt 0 ] && [ -z "\${raw_binds[-1]}" ]; then
      unset 'raw_binds[${#raw_binds[@]}-1]'
    fi

    if [ \${#raw_binds[@]} -eq 0 ]; then
      dsh_print "No volume mounts found." "\$INFO"
      exit 0
    fi

    # Build container -> host map from all host binds (for /dev/null resolution)
    map_ct=(); map_hp=()
    for bind in "\${raw_binds[@]}"; do
      hp="\${bind%%:*}"
      case "\$hp" in */*) ;; *) continue ;; esac
      [ "\$hp" = "/dev/null" ] && continue
      cp="\${bind#*:}"
      case "\$cp" in *:ro) cp="\${cp%:ro}" ;; esac
      if [ "\$cp" != "/" ]; then cp="\${cp%/}"; fi
      hp="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
      if [ "\$hp" != "/" ]; then hp="\${hp%/}"; fi
      map_ct+=("\$cp"); map_hp+=("\$hp")
    done
    resolve_ct() {
      local ct="\$1" j cp hp best="" best_len=-1 sfx
      for j in "\${!map_ct[@]}"; do
        cp="\${map_ct[\$j]}"
        if [[ "\$ct" == "\$cp" || "\$ct" == "\$cp/"* ]]; then
          if (( \${#cp} > best_len )); then
            sfx="\${ct#\$cp}"
            if [ "\$cp" = "/" ] && [ -n "\$sfx" ]; then sfx="/\$sfx"; fi
            best="\${map_hp[\$j]}\$sfx"; best_len=\${#cp}
          fi
        fi
      done
      echo "\$best"
    }

    missing_binds=()
    pass_count=0
    missing_count=0

    for bind in "\${raw_binds[@]}"; do
      hp="\${bind%%:*}"
      case "\$hp" in */*) ;; *) continue ;; esac
      cp="\${bind#*:}"
      case "\$cp" in *:ro) cp="\${cp%:ro}" ;; esac
      if [ "\$cp" != "/" ]; then cp="\${cp%/}"; fi

      if [ "\$hp" = "/dev/null" ]; then
        resolved="\$(resolve_ct "\$cp")"
        [ -n "\$resolved" ] && display="\$resolved" || display="\$cp"
        check="\$display"
        tag_col="$ERROR"; tag="[x]"
      else
        display="\$(echo "\$hp" | sed "s|^\\\${HOME}|\$HOME|; s|^\~|\$HOME|")"
        if [[ "\$display" != /* ]]; then display="\$DSH_DIR/\$display"; fi
        check="\$display"
        case "\$bind" in
          *:ro) tag_col="$INFO"; tag="[r]" ;;
          *)   tag_col="$SUCCESS"; tag="[w]" ;;
        esac
      fi

      if [ -e "\$check" ]; then
        pass_count=\$((pass_count + 1))
        dsh_print "PASS - \${tag_col}\${tag}\${ENDCOLOR} \$display" "\$SUCCESS"
      else
        missing_count=\$((missing_count + 1))
        missing_binds+=("\$bind")
        dsh_print "MISS - \${tag_col}\${tag}\${ENDCOLOR} \$display" "\$ERROR"
      fi
    done

    echo ""
    dsh_print "Total: \$((pass_count + missing_count)) | Passed: \$pass_count | Missing: \$missing_count" "\$INFO"

    if [ \$missing_count -eq 0 ]; then
      dsh_print "All volume mounts are valid." "\$SUCCESS"
      exit 0
    fi

    echo ""
    read -rp "$(echo -e "\033[1;34m[dsh]\033[0m") Would you like to remove these missing volume entries from compose.yml? (y/n): " answer
    if [[ ! "\$answer" =~ ^[Yy]\$ ]]; then
      dsh_print "Aborted. No changes made." "\$INFO"
      exit 0
    fi

    # Build a list of raw bind strings to remove (use original unexpanded form)
    remove_set=()
    for bind in "\${missing_binds[@]}"; do
      remove_set+=("\$bind")
    done

    # Rewrite compose.yml, dropping missing bind lines
    mapfile -t all_lines < "\$COMPOSE_FILE"
    out_lines=()
    in_volumes=0
    vol_block_start=0

    for ((li=0; li<\${#all_lines[@]}; li++)); do
      line="\${all_lines[\$li]}"

      # Detect second volumes: block start
      if [[ "\$line" =~ ^[[:space:]]*volumes: ]]; then
        vol_block_start=\$((vol_block_start + 1))
        if [ "\$vol_block_start" -eq 2 ]; then
          in_volumes=1
          out_lines+=("\$line")
          continue
        fi
      fi

      # End of volumes block when we hit a non-indented, non-empty line
      if [ "\$in_volumes" -eq 1 ]; then
        # Check if this is a continuation of the volumes block
        if [[ "\$line" =~ ^[[:space:]] ]] || [ -z "\$line" ]; then
          # This is inside the volumes block — check if it's a bind entry to skip
          bind_entry="\$(echo "\$line" | sed -E 's/^[[:space:]]*-[[:space:]]//; s/[[:space:]]*$//')"
          skip=0
          for rb in "\${remove_set[@]}"; do
            if [ "\$bind_entry" = "\$rb" ]; then
              skip=1
              break
            fi
          done
          if [ "\$skip" -eq 1 ]; then
            continue  # Skip this line
          fi
          out_lines+=("\$line")
          continue
        else
          in_volumes=0
        fi
      fi

      out_lines+=("\$line")
    done

    printf '%s\n' "\${out_lines[@]}" > "\$COMPOSE_FILE"
    dsh_print "Removed \$missing_count missing volume entry/entries from compose.yml." "\$SUCCESS"
    ;;

  *)
    # Run as the same user the DSH server runs as (node, HOME=/home/node) so
    # profile/plugin installs land in the persisted /home/node/.dsh profile
    # directory. docker exec defaults to root, whose ~/.dsh is
    # container-local and wiped on every container recreate.
    if [ -t 0 ]; then
      docker exec -it -u node -e HOME=/home/node -w /home/node/app dsh-deepseek-harness pnpm dsh "\$@"
    else
      docker exec -i -u node -e HOME=/home/node -w /home/node/app dsh-deepseek-harness pnpm dsh "\$@"
    fi
    ;;
esac
EOF

chmod a+x "$WRAPPER"
dsh_print "Created dsh wrapper binary at:$LOCATION $WRAPPER$ENDCOLOR" "$SUCCESS"
echo

dsh start >/dev/null 2>&1
dsh_print "Installing & Updating recommended plugins (may take a while)" "$INFO"
dsh plugin --profile web add dshmarket >/dev/null 2>&1
dsh plugin --profile web add dsh-searxng >/dev/null 2>&1
dsh plugin --profile web add dsh-context >/dev/null 2>&1
dsh plugin --profile web add dsh-cost-meter >/dev/null 2>&1
dsh plugin --profile web add dsh-strata >/dev/null 2>&1
dsh plugin --profile web add oss-prompt-optimizer >/dev/null 2>&1
dsh plugin --profile web add @linxin666/dsh-client-ui-skill-explorer@latest >/dev/null 2>&1
dsh plugin --profile web add @michengai/dsh-archive-manager@latest --registry=https://registry.npmjs.org/ >/dev/null 2>&1
dsh stop >/dev/null 2>&1
dsh_print "Installed dsh plugins" "$SUCCESS"


# Create ~/.dsh if not present already
DSH_CONFIG_DIR="$HOME/.dsh"
if [ ! -d "$DSH_CONFIG_DIR" ]; then
  mkdir -p "$DSH_CONFIG_DIR"
elif [ "$(stat -c '%u' "$DSH_CONFIG_DIR")" != "$(id -u)" ]; then
  chown -R "$(id -u):$(id -g)" "$DSH_CONFIG_DIR"
  dsh_print "Changed $LOCATION~/.dsh$ENDCOLOR ownership from root (assigned by DSH build) to your user '$(WHOAMI)'" "$SUCCESS"
fi

echo
echo "-----------------------------------------------------------------------------------------------"
echo
dsh_print "SUCCESSFULLY INSTALLED" "$SUCCESS"
echo
dsh_print "IMPORTANT:" "$IMPORTANT"
dsh_print "To avoid sandboxing issues, make sure to always run with 'Full Access'" "$IMPORTANT"
dsh_print "Doing this is NOT a security concern as Docker provides isolation through volume mounting" "$IMPORTANT"
echo

print_help
